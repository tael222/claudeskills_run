# Claude API
ANTHROPIC_API_KEY=your_api_key_here

# Database
DATABASE_URL=sqlite:///./claudeskills.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Skills
SKILLS_DIR=./skills
CUSTOM_SKILLS_DIR=~/.claude/skills
